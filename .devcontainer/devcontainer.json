{
  // AgentTrace in Codespaces: Python 3.12 + Node 22 + Rust, matching the
  // nightly-drill CI toolchain (.github/workflows/nightly-drill.yml).
  // Opens this repo ready to run its tests, verifier, and dashboard.
  // Note: the full platform drill additionally needs the six producer
  // repos checked out as siblings of this one (see ci/run_drill_ci.sh);
  // clone them into the parent directory to run it here.
  "name": "agent-trace",
  "image": "mcr.microsoft.com/devcontainers/python:1-3.12-bookworm",
  "features": {
    "ghcr.io/devcontainers/features/node:1": {
      "version": "22"
    },
    "ghcr.io/devcontainers/features/rust:1": {}
  },
  "postCreateCommand": "python3 -m venv .venv && .venv/bin/pip install -e \".[dev]\"",
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-python.python",
        "rust-lang.rust-analyzer"
      ]
    }
  }
}
